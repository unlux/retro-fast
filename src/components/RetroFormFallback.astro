---
const skeleton = 'rounded-[var(--radius-control)] bg-[var(--ds-skeleton,#0515240f)] motion-safe:animate-skeleton-fade';
---
<div data-form-fallback aria-busy="true">
  <div class="border-b border-rule py-5 text-[0.8125rem]">Step 1 of 8</div>
  <section class="py-7">
    <h2 class="mb-5 text-sm font-semibold">Choose a sprint</h2>
    <p class="mb-2 text-sm">Space</p>
    <div class:list={['mb-6 h-9 w-full', skeleton]}></div>
    <p class="mb-2 text-sm">Sprint</p>
    <div class:list={['h-9 w-full', skeleton]}></div>
    <p role="status" class="mt-5 text-sm text-muted">Loading sprints…</p>
  </section>
</div>
