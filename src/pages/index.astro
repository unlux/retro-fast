---
import { env } from 'cloudflare:workers';
import '@fontsource-variable/inter';
import lightThemeCss from '@atlaskit/tokens/dist/esm/artifacts/themes/atlassian-light.js';
import motionThemeCss from '@atlaskit/tokens/dist/esm/artifacts/themes/atlassian-motion.js';
import shapeThemeCss from '@atlaskit/tokens/dist/esm/artifacts/themes/atlassian-shape.js';
import spacingThemeCss from '@atlaskit/tokens/dist/esm/artifacts/themes/atlassian-spacing.js';
import typographyThemeCss from '@atlaskit/tokens/dist/esm/artifacts/themes/atlassian-typography.js';
import { RetroForm } from '../components/RetroForm';
import RetroFormFallback from '../components/RetroFormFallback.astro';
import { daysUntilExpiry } from '../lib/jira';
import { teams } from '../lib/teams';
import '../styles/global.css';

// The page itself still holds no Jira data — sprints and velocity arrive from
// the API routes over fetch — so it stays prerendered and instantly served.
export const prerender = true;

// Token expiry is read at build time. That is deliberate: it is a static date
// set alongside the token, and a prerendered page can't read it per request.
// A redeploy after rotation refreshes it; the 401 notice is the live backstop.
const expiryDays = daysUntilExpiry(env?.JIRA_TOKEN_EXPIRY);

/** Warn a month out — enough time to rotate a token without a scramble. */
const EXPIRY_WARNING_DAYS = 30;
const showExpiryBanner = expiryDays !== null && expiryDays < EXPIRY_WARNING_DAYS;
const expiryMessage =
  expiryDays === null
    ? ''
    : expiryDays < 0
      ? `The Jira API token expired ${Math.abs(expiryDays)} day${Math.abs(expiryDays) === 1 ? '' : 's'} ago. Filling from Jira will fail until it is rotated.`
      : expiryDays === 0
        ? 'The Jira API token expires today. Rotate it to keep Jira filling working.'
        : `The Jira API token expires in ${expiryDays} day${expiryDays === 1 ? '' : 's'}. Rotate it to keep Jira filling working.`;

const themeCss = [
  lightThemeCss,
  spacingThemeCss,
  shapeThemeCss,
  typographyThemeCss,
  motionThemeCss,
];
---

<!doctype html>
<html
  lang="en"
  data-color-mode="light"
  data-theme="light:light spacing:spacing shape:shape typography:typography motion:motion"
  data-workflow-mode="retro"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {/*
      A checked box drawn in black on white — the page's own aesthetic at 32px.
      SVG only: every browser this tool is used from supports it, and an .ico
      would be a second binary asset to keep in step with no one to see it.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/*
      The title is what a pinned tab and a browser history entry read as, and
      "Retro" alone says nothing about which tool it is. Named for the job.
    */}
    <title>Sprint retro</title>
    <meta
      name="description"
      content="Compose a sprint retro from Jira goals and velocity, then copy or mail it."
    />
    {themeCss.map((css) => <style is:inline set:html={css} />)}
  </head>
  <body class="px-6 py-8 max-sm:p-0">
    <main
      data-app-shell
      class="mx-auto max-w-[50rem] overflow-hidden rounded-[var(--radius-shell)] border border-rule bg-paper shadow-[var(--ds-shadow-raised,0_1px_2px_rgba(9,30,66,0.12))] max-sm:min-h-screen max-sm:rounded-none max-sm:border-x-0 max-sm:border-t-0 max-sm:shadow-none"
    >
      <header class="border-t-[3px] border-t-brand border-b border-b-rule px-8 pt-7 pb-6 max-sm:px-4 max-sm:pt-6">
        <p class="m-0 mb-1 text-xs font-semibold tracking-[0.04em] text-brand">
          Jira sprint workflow
        </p>
        <div data-shell-copy="retro">
          <h1 class="m-0 mb-1 text-2xl font-semibold tracking-[-0.015em]">Sprint retro</h1>
          {/* Instructions for using the form; meaningless once it is on paper. */}
          <p class="m-0 text-[0.8125rem] text-muted" data-print-hide>
            Fill in, copy, mail. Drafts save automatically in this browser.
          </p>
        </div>
        <div data-shell-copy="plan">
          <h1 class="m-0 mb-1 text-2xl font-semibold tracking-[-0.015em]">Sprint plan</h1>
          <p class="m-0 text-[0.8125rem] text-muted" data-print-hide>
            Write the next sprint's goals, review the Jira text, then push it.
          </p>
        </div>
      </header>

      {
        showExpiryBanner && (
          <p
          class="mx-8 mt-6 mb-0 rounded-[var(--radius-surface)] border border-warn/30 bg-warn-soft px-4 py-3 text-[0.8125rem] leading-normal text-warn max-sm:mx-4"
            role="status"
          >
            {expiryMessage}
          </p>
        )
      }

      {/*
        The whole form is one client-only React island because its first values
        come from localStorage. Astro renders a form-shaped fallback into the
        initial HTML, then replaces it as soon as React is ready.
      */}
      <div class="px-8 max-sm:px-4">
        <RetroForm teams={teams} client:only="react">
          <RetroFormFallback slot="fallback" />
        </RetroForm>
      </div>

      <footer class="mt-2 border-t border-rule bg-canvas px-8 py-5 text-[0.8125rem] text-muted max-sm:px-4">
        <p class="m-0" data-shell-copy="retro">
          Goals and points fill from Jira when a sprint is selected. Everything stays editable,
          and the form works fully by hand if Jira is unavailable.
        </p>
        <p class="m-0" data-shell-copy="plan">
          Plans save automatically for each Space. BAU items are included in the Jira goal.
        </p>
      </footer>
    </main>
  </body>
</html>
