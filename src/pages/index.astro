---
import { env } from 'cloudflare:workers';
import { RetroForm } from '../components/RetroForm';
import { daysUntilExpiry } from '../lib/jira';
import { teams } from '../lib/teams';
import '../styles/global.css';

// The page itself still holds no Jira data — sprints and velocity arrive from
// the API routes over fetch — so it stays prerendered and instantly served.
export const prerender = true;

// Token expiry is read at build time. That is deliberate: it is a static date
// set alongside the token, and a prerendered page can't read it per request.
// A redeploy after rotation refreshes it; the 401 notice is the live backstop.
const expiryDays = daysUntilExpiry(env?.JIRA_TOKEN_EXPIRY);

/** Warn a month out — enough time to rotate a token without a scramble. */
const EXPIRY_WARNING_DAYS = 30;
const showExpiryBanner = expiryDays !== null && expiryDays < EXPIRY_WARNING_DAYS;
const expiryMessage =
  expiryDays === null
    ? ''
    : expiryDays < 0
      ? `The Jira API token expired ${Math.abs(expiryDays)} day${Math.abs(expiryDays) === 1 ? '' : 's'} ago. Prefill will fail until it is rotated.`
      : expiryDays === 0
        ? 'The Jira API token expires today. Rotate it to keep prefill working.'
        : `The Jira API token expires in ${expiryDays} day${expiryDays === 1 ? '' : 's'}. Rotate it to keep prefill working.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {/*
      A checked box drawn in black on white — the page's own aesthetic at 32px.
      SVG only: every browser this tool is used from supports it, and an .ico
      would be a second binary asset to keep in step with no one to see it.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/*
      The title is what a pinned tab and a browser history entry read as, and
      "Retro" alone says nothing about which tool it is. Named for the job.
    */}
    <title>Sprint retro</title>
    <meta
      name="description"
      content="Compose a sprint retro from Jira goals and velocity, then copy or mail it."
    />
  </head>
  <body class="px-6 pt-16 pb-24 max-sm:px-4 max-sm:pt-10 max-sm:pb-16">
    <main class="mx-auto max-w-[44rem]">
      <header>
        <h1 class="m-0 mb-1 text-xl font-semibold tracking-[0.01em]">Sprint retro</h1>
        {/* Instructions for using the form; meaningless once it is on paper. */}
        <p class="m-0 text-[0.8125rem] text-muted" data-print-hide>
          Fill in, copy, mail. Drafts save automatically in this browser.
        </p>
      </header>

      {
        showExpiryBanner && (
          <p
            class="mt-8 mb-0 border border-rule border-l-[3px] border-l-warn px-3.5 py-3 text-[0.8125rem] leading-normal text-warn"
            role="status"
          >
            {expiryMessage}
          </p>
        )
      }

      {/*
        The whole form is one React island. It is `client:load` rather than
        `client:idle` because the first thing anyone does on this page is type
        into it, and a form that is briefly inert is worse than one that costs a
        few more kilobytes up front. Nothing renders server-side: every value
        comes from localStorage, which only exists in the browser.
      */}
      <RetroForm teams={teams} client:only="react" />

      <footer class="mt-10 border-t border-rule pt-5 text-[0.8125rem] text-muted">
        <p class="m-0">
          Goals and points prefill from Jira when a sprint is selected. Everything stays editable,
          and the form works fully by hand if Jira is unavailable.
        </p>
      </footer>
    </main>
  </body>
</html>
