---
import { env } from 'cloudflare:workers';
import { daysUntilExpiry } from '../lib/jira';
import { teams } from '../lib/teams';
import '../styles/form.css';

// The page itself still holds no Jira data — sprints and velocity arrive from
// the API routes over fetch — so it stays prerendered and instantly served.
export const prerender = true;

// Token expiry is read at build time. That is deliberate: it is a static date
// set alongside the token, and a prerendered page can't read it per request.
// A redeploy after rotation refreshes it; the 401 notice is the live backstop.
const expiryDays = daysUntilExpiry(env?.JIRA_TOKEN_EXPIRY);

/** Warn a month out — enough time to rotate a token without a scramble. */
const EXPIRY_WARNING_DAYS = 30;
const showExpiryBanner = expiryDays !== null && expiryDays < EXPIRY_WARNING_DAYS;
const expiryMessage =
  expiryDays === null
    ? ''
    : expiryDays < 0
      ? `The Jira API token expired ${Math.abs(expiryDays)} day${Math.abs(expiryDays) === 1 ? '' : 's'} ago. Prefill will fail until it is rotated.`
      : expiryDays === 0
        ? 'The Jira API token expires today. Rotate it to keep prefill working.'
        : `The Jira API token expires in ${expiryDays} day${expiryDays === 1 ? '' : 's'}. Rotate it to keep prefill working.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Retro</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Sprint retro</h1>
        <p class="subtitle">Fill in, copy, mail. Drafts save automatically in this browser.</p>
      </header>

      {
        showExpiryBanner && (
          <p class="banner banner-warn" role="status">
            {expiryMessage}
          </p>
        )
      }

      <section aria-labelledby="heading-details">
        <h2 id="heading-details">Details</h2>

        <div class="field-row">
          <div>
            <label for="team">Team</label>
            <select id="team">
              {teams.map((team) => <option value={team.id}>{team.name}</option>)}
            </select>
          </div>
          <div>
            <label for="jira-sprint">Sprint (from Jira)</label>
            <select id="jira-sprint">
              <option value="">Manual entry</option>
            </select>
            <p class="hint" id="jira-status" role="status" aria-live="polite">Loading sprints…</p>
          </div>
        </div>

        <div class="field-row">
          <div>
            <label for="sprint">Sprint number</label>
            <input id="sprint" type="text" inputmode="numeric" autocomplete="off" placeholder="42" />
          </div>
          <div>
            <button type="button" class="btn btn-quiet" id="prefill">Prefill from Jira</button>
            <p class="hint">Refills goals and points from the selected sprint.</p>
          </div>
        </div>

        <div class="field-row" style="grid-template-columns: 1fr">
          <div>
            <label for="title">Title</label>
            <input id="title" type="text" autocomplete="off" />
            <p class="hint">
              Composed from the team template and sprint number. Edit it and it stays as typed.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="heading-goals">
        <h2 id="heading-goals">Goals</h2>

        <p class="empty-note" id="goals-empty" hidden>No goals yet. Add one or paste a list below.</p>
        <ul class="goal-list" id="goals"></ul>

        <div class="button-row">
          <button type="button" class="btn btn-quiet" id="add-goal">Add goal</button>
        </div>

        <div class="paste-box">
          <label for="paste">Paste goals</label>
          <textarea
            id="paste"
            placeholder="Paste a list here — one per line, or separated by ; • - or 1. 2. 3."
          ></textarea>
          <div class="button-row">
            <button type="button" class="btn btn-quiet" id="split-paste">Split into rows</button>
            <button type="button" class="btn btn-quiet" id="clear-goals">Clear goals</button>
          </div>
        </div>
      </section>

      <section aria-labelledby="heading-points">
        <h2 id="heading-points">Points</h2>
        <div class="points-row">
          <div>
            <label for="completed">Completed</label>
            <input id="completed" type="number" min="0" step="1" autocomplete="off" />
          </div>
          <div>
            <label for="committed">Committed</label>
            <input id="committed" type="number" min="0" step="1" autocomplete="off" />
          </div>
        </div>
      </section>

      <section aria-labelledby="heading-notes">
        <h2 id="heading-notes">Notes</h2>
        <div class="stack">
          <div>
            <label for="comments">Comments</label>
            <textarea id="comments" placeholder="One per line"></textarea>
          </div>
          <div>
            <label for="pluses">Pluses</label>
            <textarea id="pluses" placeholder="One per line"></textarea>
          </div>
          <div>
            <label for="improvements">Improvements</label>
            <textarea id="improvements" placeholder="One per line"></textarea>
          </div>
        </div>
      </section>

      <section aria-labelledby="heading-actions">
        <h2 id="heading-actions">Actions</h2>
        <div>
          <label for="recipients">Recipients</label>
          <input
            id="recipients"
            type="text"
            autocomplete="off"
            placeholder="name@example.com, other@example.com"
          />
          <p class="hint">Comma-separated. Prefilled from the team config; edit freely.</p>
        </div>

        <div class="button-row">
          <button type="button" class="btn btn-primary" id="copy">Copy</button>
          <button type="button" class="btn" id="mail">Mail team</button>
          <button type="button" class="btn btn-quiet" id="reset">Reset form</button>
        </div>
        <p class="status-line" id="status" role="status" aria-live="polite"></p>
      </section>

      <footer>
        <p>
          Goals and points prefill from Jira when a sprint is selected. Everything stays editable,
          and the form works fully by hand if Jira is unavailable.
        </p>
      </footer>
    </main>

    <script>
      import { buildMailto, buildTitle, formatHtml, formatPlain, nextStatus, normalizeStatus } from '../lib/format';
      import type { Goal, RetroState } from '../lib/format';
      import { splitGoals } from '../lib/split-goals';
      import { sprintNumber } from '../lib/sprints';
      import type { Sprint } from '../lib/sprints';
      import { teams } from '../lib/teams';

      /** Manual mode has no Jira sprint id, so drafts key on a fixed sprint key. */
      const MANUAL_KEY = 'manual';
      const LAST_TEAM_KEY = 'retro:last-team';
      /** Remembers the chosen sprint per team, so a reload lands where you left. */
      const lastSprintKey = (teamId: string) => `retro:last-sprint:${teamId}`;

      const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

      const teamSelect = el<HTMLSelectElement>('team');
      const jiraSprintSelect = el<HTMLSelectElement>('jira-sprint');
      const jiraStatus = el<HTMLParagraphElement>('jira-status');
      const prefillButton = el<HTMLButtonElement>('prefill');
      const sprintInput = el<HTMLInputElement>('sprint');
      const titleInput = el<HTMLInputElement>('title');
      const goalList = el<HTMLUListElement>('goals');
      const goalsEmpty = el<HTMLParagraphElement>('goals-empty');
      const pasteBox = el<HTMLTextAreaElement>('paste');
      const completedInput = el<HTMLInputElement>('completed');
      const committedInput = el<HTMLInputElement>('committed');
      const commentsInput = el<HTMLTextAreaElement>('comments');
      const plusesInput = el<HTMLTextAreaElement>('pluses');
      const improvementsInput = el<HTMLTextAreaElement>('improvements');
      const recipientsInput = el<HTMLInputElement>('recipients');
      const statusLine = el<HTMLParagraphElement>('status');

      /** Goal rows live here; the DOM is rendered from this array. */
      let goals: Goal[] = [];
      /** True once the user edits the title by hand — stops template overwrites. */
      let titleTouched = false;
      let statusTimer: number | undefined;
      /** Sprints for the currently selected team, keyed by id for prefill lookup. */
      let sprintsById = new Map<number, Sprint>();
      /**
       * Bumped on every team or sprint change so a slow in-flight response —
       * sprint list or velocity — can't land late and overwrite the form.
       */
      let loadToken = 0;

      function currentTeam() {
        return teams.find((team) => team.id === teamSelect.value);
      }

      /** Selected Jira sprint id, or null in manual mode. */
      function currentSprintId(): number | null {
        const value = Number(jiraSprintSelect.value);
        return Number.isFinite(value) && value > 0 ? value : null;
      }

      /**
       * Drafts are per team *and* per sprint, so last sprint's retro is still
       * there when you switch back. Manual mode gets its own stable key.
       */
      function storageKey(teamId: string, sprintId: number | null = currentSprintId()): string {
        return `retro:${teamId}:${sprintId ?? MANUAL_KEY}`;
      }

      /** True when a stored draft for this team+sprint holds anything typed. */
      function draftHasContent(draft: Draft | null): boolean {
        if (!draft) return false;
        return (
          (draft.goals ?? []).some((goal) => String(goal?.text ?? '').trim() !== '') ||
          [draft.completed, draft.committed, draft.comments, draft.pluses, draft.improvements].some(
            (value) => String(value ?? '').trim() !== '',
          )
        );
      }

      function setStatus(message: string): void {
        statusLine.textContent = message;
        window.clearTimeout(statusTimer);
        if (message !== '') {
          statusTimer = window.setTimeout(() => {
            statusLine.textContent = '';
          }, 4000);
        }
      }

      // ---------------------------------------------------------------- state

      function readState(): RetroState {
        return {
          title: titleInput.value,
          goals: goals.map((goal) => ({ ...goal })),
          completed: completedInput.value,
          committed: committedInput.value,
          comments: commentsInput.value,
          pluses: plusesInput.value,
          improvements: improvementsInput.value,
        };
      }

      interface Draft extends RetroState {
        sprint: string;
        recipients: string;
        titleTouched: boolean;
      }

      function save(): void {
        const team = currentTeam();
        if (!team) return;
        const draft: Draft = {
          ...readState(),
          sprint: sprintInput.value,
          recipients: recipientsInput.value,
          titleTouched,
        };
        try {
          localStorage.setItem(storageKey(team.id), JSON.stringify(draft));
          localStorage.setItem(LAST_TEAM_KEY, team.id);
        } catch {
          // Private browsing or a full quota: the form still works, drafts just
          // don't survive a reload.
        }
      }

      function loadDraft(teamId: string, sprintId: number | null = currentSprintId()): Draft | null {
        try {
          const raw = localStorage.getItem(storageKey(teamId, sprintId));
          return raw ? (JSON.parse(raw) as Draft) : null;
        } catch {
          return null;
        }
      }

      // ---------------------------------------------------------------- goals

      function renderGoals(focusIndex?: number): void {
        goalList.replaceChildren();

        goals.forEach((goal, index) => {
          const row = document.createElement('li');
          row.className = 'goal-row';

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'status-toggle';
          toggle.dataset.status = goal.status;
          toggle.textContent = goal.status;
          toggle.setAttribute('aria-label', `Goal ${index + 1} status: ${goal.status}. Toggle.`);
          toggle.addEventListener('click', () => {
            goals[index]!.status = nextStatus(goals[index]!.status);
            // The row is rebuilt from scratch, so keyboard focus has to be put
            // back on the button that was just pressed.
            renderGoals();
            (
              goalList.children[index]?.querySelector('.status-toggle') as HTMLButtonElement | null
            )?.focus();
            save();
          });

          const text = document.createElement('input');
          text.type = 'text';
          text.value = goal.text;
          text.setAttribute('aria-label', `Goal ${index + 1} text`);
          text.addEventListener('input', () => {
            goals[index]!.text = text.value;
            save();
          });
          text.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter') return;
            event.preventDefault();
            goals.splice(index + 1, 0, { text: '', status: 'wip' });
            renderGoals(index + 1);
            save();
          });

          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'remove-goal';
          remove.textContent = '×';
          remove.setAttribute('aria-label', `Remove goal ${index + 1}`);
          remove.addEventListener('click', () => {
            goals.splice(index, 1);
            // Land on the row that took the deleted one's place, or the new last
            // row when the end was removed; `undefined` when nothing is left.
            renderGoals(goals.length === 0 ? undefined : Math.min(index, goals.length - 1));
            save();
          });

          row.append(toggle, text, remove);
          goalList.append(row);
        });

        goalsEmpty.hidden = goals.length > 0;

        if (focusIndex !== undefined) {
          const input = goalList.children[focusIndex]?.querySelector('input');
          (input as HTMLInputElement | null)?.focus();
        }
      }

      function addGoals(texts: string[]): void {
        for (const text of texts) goals.push({ text, status: 'wip' });
      }

      // ---------------------------------------------------------------- title

      function applyTitleTemplate(): void {
        if (titleTouched) return;
        const team = currentTeam();
        if (!team) return;
        titleInput.value = buildTitle(team.titleTemplate, sprintInput.value);
      }

      // ----------------------------------------------------------------- jira

      /** Non-blocking note under the sprint picker. Never an alert. */
      function setJiraStatus(message: string, tone: 'plain' | 'warn' = 'plain'): void {
        jiraStatus.textContent = message;
        jiraStatus.dataset.tone = tone;
      }

      /**
       * A 401 is the one Jira failure worth naming: it is fixable, and every
       * route will keep failing until someone rotates the token.
       */
      function noteTokenExpired(): void {
        setJiraStatus('Jira token invalid or expired — enter values manually.', 'warn');
      }

      /** Fill the sprint dropdown for a team. Failure leaves manual mode intact. */
      async function loadSprints(teamId: string): Promise<void> {
        const token = ++loadToken;
        sprintsById = new Map();
        jiraSprintSelect.replaceChildren(new Option('Manual entry', ''));
        setJiraStatus('Loading sprints…');

        let response: Response;
        try {
          response = await fetch(`/api/sprints?team=${encodeURIComponent(teamId)}`);
        } catch {
          if (token === loadToken) {
            setJiraStatus('Could not reach Jira — enter values manually.', 'warn');
          }
          return;
        }
        // A team switch landed first; this response is stale.
        if (token !== loadToken) return;

        if (response.status === 401) {
          noteTokenExpired();
          return;
        }
        if (!response.ok) {
          setJiraStatus('Jira sprints unavailable — enter values manually.', 'warn');
          return;
        }

        let body: { sprints?: Sprint[]; defaultSprintId?: number | null };
        try {
          body = await response.json();
        } catch {
          setJiraStatus('Jira sent an unreadable response — enter values manually.', 'warn');
          return;
        }
        if (token !== loadToken) return;

        const sprints = Array.isArray(body.sprints) ? body.sprints : [];
        if (sprints.length === 0) {
          setJiraStatus('No sprints on this board — enter values manually.');
          return;
        }

        for (const sprint of sprints) {
          sprintsById.set(sprint.id, sprint);
          const label = sprint.state === 'active' ? `${sprint.name} (active)` : sprint.name;
          jiraSprintSelect.append(new Option(label, String(sprint.id)));
        }

        // Prefer the sprint last used for this team; otherwise the server's
        // default (active sprint, else most recently closed).
        let selected = body.defaultSprintId ?? null;
        try {
          const remembered = Number(localStorage.getItem(lastSprintKey(teamId)));
          if (sprintsById.has(remembered)) selected = remembered;
        } catch {
          /* ignore */
        }

        jiraSprintSelect.value = selected === null ? '' : String(selected);
        setJiraStatus('');
        await selectSprint({ silent: true });
      }

      /** Velocity for one sprint, or null whenever it isn't available. */
      async function loadVelocity(
        teamId: string,
        sprintId: number,
      ): Promise<{ committed: number; completed: number } | null> {
        try {
          const response = await fetch(
            `/api/velocity?team=${encodeURIComponent(teamId)}&sprintId=${sprintId}`,
          );
          if (response.status === 401) {
            noteTokenExpired();
            return null;
          }
          const body = (await response.json()) as {
            available?: boolean;
            committed?: number;
            completed?: number;
          };
          if (body.available !== true) return null;
          // A malformed payload must not write "NaN" into the points fields.
          const committed = Number(body.committed);
          const completed = Number(body.completed);
          if (!Number.isFinite(committed) || !Number.isFinite(completed)) return null;
          return { committed, completed };
        } catch {
          // Velocity is best-effort by design: the points fields just stay put.
          return null;
        }
      }

      /**
       * Apply a sprint's Jira data to the form.
       *
       * Never overwrites a draft that has content without asking: the draft is
       * the user's own work, and a retro is usually half-written before anyone
       * touches the sprint picker again.
       */
      async function applyPrefill(sprint: Sprint, options: { confirmOverwrite: boolean }): Promise<void> {
        const team = currentTeam();
        if (!team) return;

        if (options.confirmOverwrite) {
          const proceed = window.confirm(
            `Replace the goals and points for ${sprint.name} with the values from Jira? Your notes are kept.`,
          );
          if (!proceed) return;
        }

        const rows = splitGoals(sprint.goal ?? '');
        if (rows.length > 0) {
          goals = rows.map((text) => ({ text, status: 'wip' as const }));
          renderGoals();
        }

        const number = sprintNumber(sprint.name);
        if (number !== '') {
          sprintInput.value = number;
          applyTitleTemplate();
        }

        save();

        // Velocity is the one awaited step, so a team or sprint switch can land
        // while it is in flight. Snapshot what this prefill is for, and drop the
        // response if any of it has moved on — otherwise last sprint's points
        // get written over the sprint now on screen, and `save()` persists them.
        const token = loadToken;
        const forTeam = team.id;
        const forSprint = sprint.id;

        const velocity = await loadVelocity(team.id, sprint.id);
        if (
          token !== loadToken ||
          teamSelect.value !== forTeam ||
          currentSprintId() !== forSprint
        ) {
          return;
        }

        if (velocity) {
          committedInput.value = String(velocity.committed);
          completedInput.value = String(velocity.completed);
          setJiraStatus(`Prefilled ${rows.length} goal${rows.length === 1 ? '' : 's'} and points.`);
        } else {
          // Silent-but-labeled: say the numbers are missing, don't raise an error.
          setJiraStatus(
            rows.length > 0
              ? `Prefilled ${rows.length} goal${rows.length === 1 ? '' : 's'}. Points unavailable — type them in.`
              : 'This sprint has no goal text. Points unavailable — type them in.',
          );
        }
        save();
      }

      /**
       * Handle a sprint selection: swap to that sprint's draft, then prefill
       * from Jira only when there is nothing to lose (or the user says so).
       */
      async function selectSprint(options: { silent?: boolean } = {}): Promise<void> {
        const team = currentTeam();
        if (!team) return;

        const sprintId = currentSprintId();
        try {
          if (sprintId === null) localStorage.removeItem(lastSprintKey(team.id));
          else localStorage.setItem(lastSprintKey(team.id), String(sprintId));
        } catch {
          /* ignore */
        }

        // Load whatever draft belongs to this team+sprint first.
        restore(team.id);

        if (sprintId === null) {
          if (!options.silent) setJiraStatus('Manual entry.');
          return;
        }

        const sprint = sprintsById.get(sprintId);
        if (!sprint) return;

        const draft = loadDraft(team.id, sprintId);
        if (draftHasContent(draft)) {
          // Respect the draft. Prefill stays one explicit click away.
          setJiraStatus('Saved draft restored. Use “Prefill from Jira” to replace it.');
          return;
        }

        await applyPrefill(sprint, { confirmOverwrite: false });
      }

      // -------------------------------------------------------------- actions

      /** Load the draft for `teamId` at the currently selected sprint. */
      function restore(teamId: string): void {
        const team = teams.find((t) => t.id === teamId);
        if (!team) return;

        const draft = loadDraft(teamId);
        goals = Array.isArray(draft?.goals)
          ? draft.goals
              .filter((goal): goal is Goal => !!goal && typeof goal.text === 'string')
              .map((goal) => ({ text: goal.text, status: normalizeStatus(goal.status) }))
          : [];
        titleTouched = draft?.titleTouched === true;

        sprintInput.value = draft?.sprint ?? '';
        completedInput.value = draft?.completed ?? '';
        committedInput.value = draft?.committed ?? '';
        commentsInput.value = draft?.comments ?? '';
        plusesInput.value = draft?.pluses ?? '';
        improvementsInput.value = draft?.improvements ?? '';
        recipientsInput.value = draft?.recipients ?? team.recipients.join(', ');

        if (draft?.title) {
          titleInput.value = draft.title;
        } else {
          applyTitleTemplate();
        }

        renderGoals();
      }

      async function copyOutput(): Promise<void> {
        const state = readState();
        const plain = formatPlain(state);
        if (plain === '') {
          setStatus('Nothing to copy yet.');
          return;
        }
        const html = formatHtml(state);

        try {
          // Both flavours in one clipboard item: Apple Mail takes the HTML,
          // Notes and Slack take the plain text.
          await navigator.clipboard.write([
            new ClipboardItem({
              'text/plain': new Blob([plain], { type: 'text/plain' }),
              'text/html': new Blob([html], { type: 'text/html' }),
            }),
          ]);
          setStatus('Copied.');
        } catch {
          try {
            await navigator.clipboard.writeText(plain);
            setStatus('Copied as plain text.');
          } catch {
            setStatus('Copy failed — select the text manually.');
          }
        }
      }

      function mailTeam(): void {
        const state = readState();
        const plain = formatPlain(state);
        if (plain === '') {
          setStatus('Nothing to send yet.');
          return;
        }
        const recipients = recipientsInput.value
          .split(/[,;]/)
          .map((address) => address.trim())
          .filter((address) => address.length > 0);

        window.location.href = buildMailto(recipients, state.title, plain);
      }

      // ----------------------------------------------------------- wiring up

      teamSelect.addEventListener('change', () => {
        // Reset to manual first so the draft restored below is the manual one
        // if the sprint list never arrives.
        jiraSprintSelect.value = '';
        restore(teamSelect.value);
        try {
          localStorage.setItem(LAST_TEAM_KEY, teamSelect.value);
        } catch {
          /* ignore */
        }
        void loadSprints(teamSelect.value);
      });

      jiraSprintSelect.addEventListener('change', () => {
        // Same invalidation as a team switch: any prefill still awaiting Jira
        // belongs to the sprint we just left.
        loadToken += 1;
        void selectSprint();
      });

      prefillButton.addEventListener('click', () => {
        const sprintId = currentSprintId();
        const sprint = sprintId === null ? undefined : sprintsById.get(sprintId);
        if (!sprint) {
          setJiraStatus('Pick a Jira sprint first.');
          return;
        }
        // Explicit click on a draft with content: ask before replacing it.
        const draft = loadDraft(teamSelect.value, sprintId);
        // This click supersedes any prefill still awaiting Jira.
        loadToken += 1;
        void applyPrefill(sprint, { confirmOverwrite: draftHasContent(draft) });
      });

      sprintInput.addEventListener('input', () => {
        applyTitleTemplate();
        save();
      });

      titleInput.addEventListener('input', () => {
        titleTouched = true;
        save();
      });

      for (const input of [
        completedInput,
        committedInput,
        commentsInput,
        plusesInput,
        improvementsInput,
        recipientsInput,
      ]) {
        input.addEventListener('input', save);
      }

      el<HTMLButtonElement>('add-goal').addEventListener('click', () => {
        goals.push({ text: '', status: 'wip' });
        renderGoals(goals.length - 1);
        save();
      });

      el<HTMLButtonElement>('split-paste').addEventListener('click', () => {
        const rows = splitGoals(pasteBox.value);
        if (rows.length === 0) {
          setStatus('Nothing to split.');
          return;
        }
        addGoals(rows);
        pasteBox.value = '';
        renderGoals();
        save();
        setStatus(`Added ${rows.length} goal${rows.length === 1 ? '' : 's'}.`);
      });

      // Pasting straight into the box splits immediately — the button is the
      // fallback for people who type or edit before splitting.
      pasteBox.addEventListener('paste', (event) => {
        const text = event.clipboardData?.getData('text/plain');
        if (!text || text.trim() === '') return;
        // Split first: if nothing usable comes out, don't swallow the paste —
        // let it land in the box so the text isn't silently lost.
        const rows = splitGoals(text);
        if (rows.length === 0) return;
        event.preventDefault();
        addGoals(rows);
        renderGoals();
        save();
        setStatus(`Added ${rows.length} goal${rows.length === 1 ? '' : 's'}.`);
      });

      el<HTMLButtonElement>('clear-goals').addEventListener('click', () => {
        goals = [];
        renderGoals();
        save();
      });

      el<HTMLButtonElement>('copy').addEventListener('click', () => void copyOutput());
      el<HTMLButtonElement>('mail').addEventListener('click', mailTeam);

      el<HTMLButtonElement>('reset').addEventListener('click', () => {
        if (!window.confirm('Clear the draft for this team and sprint?')) return;
        const team = currentTeam();
        if (team) {
          try {
            localStorage.removeItem(storageKey(team.id));
          } catch {
            /* ignore */
          }
        }
        titleTouched = false;
        restore(teamSelect.value);
        setStatus('Form reset.');
      });

      // -------------------------------------------------------------- startup

      let initialTeam = teams[0]?.id ?? '';
      try {
        const last = localStorage.getItem(LAST_TEAM_KEY);
        if (last && teams.some((team) => team.id === last)) initialTeam = last;
      } catch {
        /* ignore */
      }

      teamSelect.value = initialTeam;
      // Render the manual draft immediately: the form is usable before (and
      // without) any Jira response.
      restore(initialTeam);
      void loadSprints(initialTeam);
    </script>
  </body>
</html>
